# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java follows google-java-format (enforced by Spotless): 2-space indent, 100 columns
[*.java]
indent_size = 2
max_line_length = 100

[*.{xml,yml,yaml,json,ts,html,scss,css}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf

[Makefile]
indent_style = tab
