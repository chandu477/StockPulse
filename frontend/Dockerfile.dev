# Angular 19 toolchain on Node 22 (host Node 24/26 is not supported by Angular 19). Includes
# Chromium for Karma (ChromeHeadlessCI). Used by the `ng` and `frontend` compose services.
FROM node:22-alpine
RUN apk add --no-cache chromium git
ENV CHROME_BIN=/usr/bin/chromium \
    NG_CLI_ANALYTICS=false \
    NG_FORCE_TTY=false
RUN npm install -g @angular/cli@19
WORKDIR /app
