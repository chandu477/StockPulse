# StockPulse environment template.
# Copy to .env (gitignored) and fill in values. NEVER commit .env or real keys.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Docker Compose profiles (optional). Default services: postgres + rabbitmq + backend.
#   frontend  Angular 19 dev server on Node 22 (after FE-01)
#   tools     Angular CLI container: docker compose run --rm ng <args>
#   ai-local  Ollama local LLM
#   llm-sim   WireMock LLM simulator for QA failure injection
# Example: COMPOSE_PROFILES=frontend,ai-local
COMPOSE_PROFILES=

# ---------------------------------------------------------------------------
# Database (docker-compose postgres service; the backend derives DB_URL/DB_USERNAME/DB_PASSWORD from these)
POSTGRES_DB=stockpulse
POSTGRES_USER=stockpulse
# Required. Choose any local password.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# RabbitMQ (used by the PostgreSQL/Docker backend profile).
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=stockpulse
# Required for Docker Compose. Choose a local password; it may differ from POSTGRES_PASSWORD.
RABBITMQ_PASSWORD=
RABBITMQ_PORT_HOST=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Only when running the backend on the host against PostgreSQL
# (./mvnw spring-boot:run -Dspring-boot.run.profiles=postgres):
DB_URL=jdbc:postgresql://localhost:5432/stockpulse
DB_USERNAME=stockpulse
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Ports (host side)
BACKEND_PORT=8080
FRONTEND_PORT=4200
OLLAMA_PORT=11434
LLM_SIM_PORT=8089

# ---------------------------------------------------------------------------
# LLM (used only when the ai strategy is active; default strategy is rule).
# The key is read ONLY from LLM_API_KEY. Pick ONE provider block.

# Groq free tier (DEFAULT, ADR-10; OpenAI-compatible). Free key at https://console.groq.com/keys
# Fast free-tier model; check https://console.groq.com/docs/models if Groq has renamed it.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com
LLM_API_KEY=

# Ollama in docker compose (--profile ai-local), offline backup. No key needed.
#   then: docker compose exec ollama ollama pull llama3.1:8b
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
# LLM_BASE_URL=http://ollama:11434
# LLM_API_KEY=

# Gemini (use a currently supported Flash model; 1.5 Flash is retired)
# LLM_PROVIDER=gemini
# LLM_MODEL=<current-gemini-flash-model>
# LLM_BASE_URL=https://generativelanguage.googleapis.com
# LLM_API_KEY=

# QA LLM simulator in docker compose (--profile llm-sim), OpenAI-compatible stubs
# LLM_PROVIDER=groq
# LLM_MODEL=simulated
# LLM_BASE_URL=http://llm-sim:8080
# LLM_API_KEY=simulator-not-a-real-key

# ---------------------------------------------------------------------------
# CORS (backend)
STOCKPULSE_CORS_ALLOWED_ORIGINS=http://localhost:4200
